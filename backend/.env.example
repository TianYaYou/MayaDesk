# Server Binding (Local only, exposed externally via Cloudflare Tunnel)
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# SQLite Metadata Database
DATABASE_URL=sqlite://./data/mayadesk.db?mode=rwc

# JWT & Session Security
JWT_SECRET=replace-with-strong-32-byte-secret-key
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_DAYS=30

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://drive.example.com/api/v1/auth/google/callback

# Cloudflare Tunnel & P2P STUN Configuration
CF_TUNNEL_TOKEN=your-cloudflare-zero-trust-tunnel-token
STUN_SERVERS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
P2P_HANDSHAKE_TIMEOUT_MS=1500

# Multi-Disk NAS Storage Pools (JSON or Comma-Separated Mounts)
PRIVATE_POOL_ROOT=/mnt/nvme_pool/users
SHARED_POOLS=media:/mnt/hdd_array_1/media,team:/mnt/hdd_array_2/team_share
