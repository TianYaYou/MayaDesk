# Multi-Stage Ultra-Lightweight Rust Build for MayaDesk Server
FROM rust:1.83-slim-bookworm AS builder
WORKDIR /usr/src/mayadesk
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml ./
COPY backend ./backend
COPY desktop/src-tauri ./desktop/src-tauri
RUN cargo build --release --package mayadesk-server

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/mayadesk/target/release/mayadesk-server /app/mayadesk-server
EXPOSE 8080/tcp 51820/udp
ENTRYPOINT ["/app/mayadesk-server"]
