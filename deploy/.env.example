# ==============================================================================
# MayaDesk Docker 部署环境变量配置模板 (复制为 deploy/.env 使用)
# ==============================================================================

# 1. 基础监听与访问地址
HOST_BIND_IP=0.0.0.0
SERVER_PORT=8080
P2P_UDP_PORT=51820
PUBLIC_URL=https://drive.example.com

# 2. 宿主机路径映射（可修改为服务器上的任意绝对路径）
HOST_CONFIG_PATH=../config/config.toml
HOST_DATA_DIR=../data/appdata

# 3. 多盘 NAS 物理硬盘宿主机路径映射（支持挂载多块机械盘/固态盘/RAID阵列）
HOST_PRIVATE_DISK_PATH=../data/disks/private_nvme
HOST_SHARED_DISK1_PATH=../data/disks/shared_disk1
HOST_SHARED_DISK2_PATH=../data/disks/shared_disk2

# 4. 鉴权密钥与 Google OAuth 2.0 登录参数
JWT_SECRET=please-replace-with-a-strong-random-key-for-production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://drive.example.com/api/v1/auth/google/callback

# 5. 独立 Cloudflare Tunnel 令牌（填入后使用 docker compose --profile tunnel up -d 启动）
CF_TUNNEL_TOKEN=
